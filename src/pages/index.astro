---
import UiLayout from '@jbpark/ui-kit/Layout';
import Space from '@jbpark/ui-kit/Space';
import Typography from '@jbpark/ui-kit/Typography';

import ProjectCard from '../components/ProjectCard';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Jeongbin Park"
  description="React library author. Building UI kits, hooks, and dev tooling."
>
  <UiLayout>
    <UiLayout.Header className="mx-auto w-full max-w-3xl justify-between px-6">
      <Typography.Text className="text-sm font-medium text-muted-foreground">
        jbpark
      </Typography.Text>
      <nav class="text-sm">
        <Space size={24}>
          <Typography.Link href="#projects" className="text-muted-foreground hover:text-foreground">
            Projects
          </Typography.Link>
          <Typography.Link
            href="https://github.com/pjb0811"
            target="_blank"
            rel="noopener noreferrer"
            className="text-muted-foreground hover:text-foreground"
          >
            GitHub
          </Typography.Link>
        </Space>
      </nav>
    </UiLayout.Header>

    <UiLayout.Content className="mx-auto w-full max-w-3xl px-6 pb-24">
      <section class="mt-12">
        <Typography.Title level={1} className="tracking-tight">
          Jeongbin Park
        </Typography.Title>
        <Typography.Paragraph className="mt-4 max-w-xl text-lg text-muted-foreground">
          I build React libraries and UI tooling — component kits, hooks, and a
          live editor that syncs canvas edits back to source code.
        </Typography.Paragraph>
      </section>

      <section id="projects" class="mt-20 scroll-mt-10">
        <Typography.Text className="text-sm font-semibold tracking-wider text-muted-foreground uppercase">
          Projects
        </Typography.Text>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {projects.map(project => <ProjectCard project={project} />)}
        </div>
      </section>
    </UiLayout.Content>

    <UiLayout.Footer className="mx-auto w-full max-w-3xl border-t border-border px-6 pt-8 pb-12 text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} Jeongbin Park</p>
    </UiLayout.Footer>
  </UiLayout>
</Layout>
