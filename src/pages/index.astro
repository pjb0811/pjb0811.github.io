---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout
  title="Jeongbin Park"
  description="React library author. Building UI kits, hooks, and dev tooling."
>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <header class="flex items-center justify-between">
      <span class="text-sm font-medium text-neutral-400">jbpark</span>
      <nav class="flex gap-6 text-sm text-neutral-400">
        <a href="#projects" class="hover:text-neutral-100">Projects</a>
        <a href="https://github.com/pjb0811" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-100">
          GitHub
        </a>
      </nav>
    </header>

    <section class="mt-20">
      <h1 class="text-4xl font-bold tracking-tight text-neutral-50 sm:text-5xl">
        Jeongbin Park
      </h1>
      <p class="mt-4 max-w-xl text-lg text-neutral-400">
        I build React libraries and UI tooling — component kits, hooks, and a
        live editor that syncs canvas edits back to source code.
      </p>
    </section>

    <section id="projects" class="mt-20 scroll-mt-10">
      <h2 class="text-sm font-semibold tracking-wider text-neutral-500 uppercase">
        Projects
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <footer class="mt-24 border-t border-neutral-800 pt-8 text-sm text-neutral-500">
      <p>&copy; {new Date().getFullYear()} Jeongbin Park</p>
    </footer>
  </main>
</Layout>
