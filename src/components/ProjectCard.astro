---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6 transition-colors hover:border-neutral-700">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold text-neutral-50">{project.name}</h3>
      <p class="mt-1 text-sm text-neutral-400">{project.tagline}</p>
    </div>
    {project.npmUrl && project.npmPackage && (
      <img
        src={`https://img.shields.io/npm/v/${project.npmPackage}?style=flat-square&color=white&labelColor=262626`}
        alt={`npm version for ${project.npmPackage}`}
        class="mt-1 h-5"
        loading="lazy"
      />
    )}
  </div>

  <p class="mt-4 text-sm leading-relaxed text-neutral-300">{project.description}</p>

  <ul class="mt-4 flex flex-wrap gap-2">
    {project.stack.map((tech) => (
      <li class="rounded-full bg-neutral-800 px-2.5 py-1 text-xs text-neutral-300">{tech}</li>
    ))}
  </ul>

  <div class="mt-6 flex gap-4 text-sm">
    <a
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-neutral-100 underline-offset-4 hover:underline"
    >
      GitHub →
    </a>
    {project.npmUrl && (
      <a
        href={project.npmUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-neutral-100 underline-offset-4 hover:underline"
      >
        npm →
      </a>
    )}
    {project.demoUrl && (
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-neutral-100 underline-offset-4 hover:underline"
      >
        Demo →
      </a>
    )}
  </div>
</article>
